    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.zookeeper</groupId>
        <artifactId>zookeeper-metrics-providers</artifactId>
        <version>3.10.0-SNAPSHOT</version>
    </parent>

    <artifactId>zookeeper-otel-metrics</artifactId>
    <packaging>jar</packaging>
    <name>Apache ZooKeeper - Otel Metrics Provider</name>
    <description>ZooKeeper Otel Metrics Provider implementation</description>
    <properties>
        <otel.version>1.26.0</otel.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.apache.zookeeper</groupId>
            <!-- we can create a metrics-providers-api package
                 once we get rid of ant based build
                 https://issues.apache.org/jira/browse/ZOOKEEPER-3376
            -->
            <artifactId>zookeeper</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>${otel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>${otel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-prometheus</artifactId>
            <version>${otel.version}-alpha</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <version>${otel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-runtime-metrics</artifactId>
            <version>${otel.version}-alpha</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
            <version>${otel.version}-alpha</version>
        </dependency>
    </dependencies>

</project>